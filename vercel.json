{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auctions.ts": {
      "maxDuration": 30,
      "includeFiles": "auctions_store.json"
    },
    "api/auth.ts": {
      "maxDuration": 15
    },
    "api/notify-offer.ts": {
      "maxDuration": 15
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|favicon\\.ico|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*|pwa-.*|apple-touch-icon\\.png|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
