{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auctions.ts": {
      "maxDuration": 30,
      "includeFiles": "auctions_store.json"
    },
    "api/auth.ts": {
      "maxDuration": 15
    },
    "api/notify-offer.ts": {
      "maxDuration": 15
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/hub/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/hub/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/hub/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/hub/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/hub/src/assets/(.*)",
      "destination": "/src/assets/$1"
    },
    {
      "source": "/hub/workbox-(.*)",
      "destination": "/workbox-$1"
    },
    {
      "source": "/hub/pwa-(.*)",
      "destination": "/pwa-$1"
    },
    {
      "source": "/hub/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/hub/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/hub/icon.svg",
      "destination": "/icon.svg"
    },
    {
      "source": "/hub/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/hub/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/hub/registerSW.js",
      "destination": "/registerSW.js"
    },
    {
      "source": "/hub",
      "destination": "/index.html"
    },
    {
      "source": "/hub/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|images/|src/assets/|favicon\\.ico|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*|pwa-.*|apple-touch-icon\\.png|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
